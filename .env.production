# ─── Database ────────────────────────────────────────────
DB_NAME=gymdb
DB_USER=gymuser
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ─── Redis ───────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ─── RabbitMQ ────────────────────────────────────────────
RABBITMQ_USER=gymadmin
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_RABBITMQ_PASSWORD

# ─── Keycloak (Internal Docker container) ───────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=Admin@Gym123
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=Gym-Saas
KEYCLOAK_CLIENT_ID=gym-api
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_CLIENT_SECRET

# ─── Frontend (Next.js public env vars) ──────────────────
NEXT_PUBLIC_API_URL=https://api.gym.hexalyte.com
NEXT_PUBLIC_KEYCLOAK_URL=http://49.12.207.238:8080
NEXT_PUBLIC_KEYCLOAK_REALM=Gym-Saas
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=gym-app

# ─── Spring Boot ─────────────────────────────────────────
SPRING_PROFILES_ACTIVE=production

# ─── Mail (Gmail SMTP) ───────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_GMAIL@gmail.com
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# ─── PayHere ─────────────────────────────────────────────
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# ─── Sentry (optional) ───────────────────────────────────
SENTRY_DSN=
