# ─── Database ────────────────────────────────────────────────
DB_NAME=gymdb
DB_USER=gymuser
DB_PASSWORD=supersecretpassword

# ─── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=redispassword

# ─── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_USER=gymuser
RABBITMQ_PASSWORD=rabbitmqpassword

# ─── Keycloak ────────────────────────────────────────────────
KEYCLOAK_URL=http://keycloak:8080
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=Gym-Saas
KEYCLOAK_CLIENT_ID=gym-api
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret-here

# ─── Spring Boot ─────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=production

# ─── Mail (SMTP) ─────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ─── PayHere (Sri Lanka Payment Gateway) ────────────────────
PAYHERE_MERCHANT_ID=your-merchant-id
PAYHERE_MERCHANT_SECRET=your-merchant-secret

# ─── Sentry (Error Monitoring) ───────────────────────────────
SENTRY_DSN=https://your-dsn@sentry.io/project-id

# ─── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:9090
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=Gym-Saas
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=gym-app
